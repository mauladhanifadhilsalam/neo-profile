---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/im-fell-english/400.css';
import '@fontsource/im-fell-english/400-italic.css';
import '@fontsource/im-fell-english-sc/400.css';
import '@fontsource/unifrakturmaguntia/400.css';
import '../styles/book.css';
import '../styles/motion.css';
import '../styles/print.css';

// The faces every leaf opens with, fetched ahead of the stylesheet so the first words are set in them.
import fellUrl from '@fontsource/im-fell-english/files/im-fell-english-latin-400-normal.woff2?url';
import fellScUrl from '@fontsource/im-fell-english-sc/files/im-fell-english-sc-latin-400-normal.woff2?url';
import garamondUrl from '@fontsource/eb-garamond/files/eb-garamond-latin-400-normal.woff2?url';

import SvgDefs from '../components/SvgDefs.astro';
import Spine, { type Section } from '../components/Spine.astro';
import { href } from '../lib/book';
import { getLeafOrder } from '../lib/collections';
import { profile } from '../data/profile';

interface Props {
  /** The page's own name; the book's name is appended. Omit on the title page. */
  title?: string;
  description: string;
  section: Section;
  /** When set, this leaf is remembered by the ribbon bookmark under this title. */
  ribbon?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const { title, description, section, ribbon, noindex = false, jsonLd } = Astro.props;
const bookName = 'Notes from the Back End';
const fullTitle = title ? `${title} · ${bookName}` : `${bookName} · ${profile.name}, ${profile.plainTitle}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(href('/og.png'), Astro.site);
const ld = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : null;
// Every leaf in reading order, so that a turn of the leaf knows which way to turn.
const leaves = (await getLeafOrder()).map((path) => href(path));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#E6DCC8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100C09" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />
    <link rel="alternate" type="application/json" href={href('/cv.json')} title="Machine-readable edition" />
    <link rel="preload" href={fellUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fellScUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={garamondUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={bookName} />
    <meta property="og:title" content={title ?? bookName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline define:vars={{ leaves }}>
      // Runs before first paint. Everything here is small, and nothing here may fail loudly.
      (function () {
        var root = document.documentElement;

        // Restore the reader's lamp, so the page never flashes the wrong paper.
        try {
          var t = localStorage.getItem('nftbe-lamp');
          if (t === 'dark' || t === 'light') root.setAttribute('data-theme', t);
        } catch (e) {}

        // Motion is an enhancement: the styles that hold things back before they are revealed
        // apply only under .js, and .js is withdrawn if the script that reveals them never arrives.
        root.classList.add('js');
        setTimeout(function () {
          if (!root.classList.contains('motion-ready')) root.classList.remove('js');
        }, 4000);

        // Turning the leaf: a leaf earlier in the book turns back, a later one turns forward.
        window.addEventListener('pagereveal', function (event) {
          try {
            var nav = /** @type {any} */ (window).navigation;
            var activation = nav && nav.activation;
            if (!event.viewTransition || !activation || !activation.from || !activation.from.url) return;
            var from = leaves.indexOf(new URL(activation.from.url).pathname);
            var to = leaves.indexOf(location.pathname);
            if (from > -1 && to > -1 && to < from) event.viewTransition.types.add('back');
          } catch (e) {}
        });
      })();
    </script>
    {ld && <script type="application/ld+json" set:html={ld} />}
  </head>
  <body data-ribbon={ribbon} data-cv={href('/cv.json')}>
    <a class="skip" href="#main">Skip to the text</a>
    <SvgDefs />
    <Spine section={section} />
    <main class="book" id="main">
      <slot />
    </main>
    <footer class="colophon">
      <p class="fleuron" aria-hidden="true">⁂</p>
      <nav aria-label="Back matter">
        <a href={href('/honours/')}>Honours</a>
        <a href={href('/colophon/')}>Colophon</a>
        <a href={href('/abridgement/')}>The Abridgement</a>
        <a href={href('/cv.json')}>cv.json</a>
      </nav>
      <p class="ru" lang="ru">«Рукописи не горят.»</p>
      <p>Manuscripts don’t burn. Bulgakov, <cite>The Master and Margarita</cite></p>
    </footer>
    <div class="lamplight" aria-hidden="true"></div>

    <script>
      import '../scripts/book';
    </script>
  </body>
</html>
