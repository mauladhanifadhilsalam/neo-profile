---
import { href } from '../lib/book';

interface Leaf {
  path: string;
  label: string;
}
interface Props {
  prev?: Leaf;
  next?: Leaf;
}
const { prev, next } = Astro.props;
---
<nav class="turn" aria-label="Turn the leaf">
  {prev && <a class="prev" href={href(prev.path)}>← <span>{prev.label}</span></a>}
  {next && <a class="next" href={href(next.path)}><span>Turn the leaf: {next.label}</span> →</a>}
</nav>
