---
import Plate from './Plate.astro';
---
<Plate number="I" caption="The ledger, composed on a queue, shewn schematically.">
  <svg viewBox="0 0 680 248" role="img" aria-labelledby="plate-ledger-title">
    <title id="plate-ledger-title">Plate I: a teacher asks for the ledger; the Laravel application accepts the request and dispatches a job; the job waits its turn on a queue; a worker composes the ledger from PostgreSQL; the ledger is ready to be fetched. The teacher's request returns at once instead of waiting.</title>
    <!-- the teacher -->
    <rect class="p-frame" x="8" y="80" width="100" height="56"></rect>
    <text class="p-title" x="58" y="104" text-anchor="middle">Teacher</text>
    <text class="p-small" x="58" y="124" text-anchor="middle">asks for the ledger</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M112,108 H146"></path>

    <!-- the application -->
    <rect class="p-fill" x="150" y="64" width="120" height="88"></rect>
    <rect class="p-frame" x="150" y="64" width="120" height="88"></rect>
    <rect class="p-inner" x="155" y="69" width="110" height="78"></rect>
    <text class="p-title" x="210" y="92" text-anchor="middle">Laravel</text>
    <text class="p-small" x="210" y="116" text-anchor="middle">accepts the request</text>
    <text class="p-small" x="210" y="134" text-anchor="middle">dispatches a job</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M274,108 H306"></path>

    <!-- the queue -->
    <text class="p-title" x="358" y="58" text-anchor="middle">Queue</text>
    <rect class="p-box" x="310" y="68" width="96" height="22"></rect>
    <rect class="p-box" x="310" y="96" width="96" height="22"></rect>
    <rect class="p-box" x="310" y="124" width="96" height="22"></rect>
    <text class="p-small" x="358" y="83" text-anchor="middle">job</text>
    <text class="p-small" x="358" y="111" text-anchor="middle">job</text>
    <text class="p-small" x="358" y="139" text-anchor="middle">job</text>
    <text class="p-text" x="358" y="166" text-anchor="middle">each in its turn</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M410,108 H442"></path>

    <!-- the worker and the database -->
    <rect class="p-fill" x="446" y="64" width="104" height="88"></rect>
    <rect class="p-frame" x="446" y="64" width="104" height="88"></rect>
    <rect class="p-inner" x="451" y="69" width="94" height="78"></rect>
    <text class="p-title" x="498" y="92" text-anchor="middle">Worker</text>
    <text class="p-small" x="498" y="116" text-anchor="middle">composes</text>
    <text class="p-small" x="498" y="134" text-anchor="middle">the ledger</text>
    <path class="p-arrow-dashed" marker-end="url(#arrowhead)" d="M498,154 V176"></path>
    <ellipse class="p-box" cx="498" cy="186" rx="32" ry="6"></ellipse>
    <path class="p-frame" d="M466,186 V210 A32,6 0 0,0 530,210 V186"></path>
    <text class="p-text" x="498" y="236" text-anchor="middle">PostgreSQL</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M554,108 H586"></path>

    <!-- the ledger -->
    <path class="p-box" d="M590,70 H658 L672,84 V146 H590 Z"></path>
    <path class="p-frame" d="M658,70 V84 H672"></path>
    <text class="p-title" x="631" y="112" text-anchor="middle">Ledger</text>
    <text class="p-text" x="631" y="166" text-anchor="middle">fetched when ready</text>

    <!-- the request does not wait -->
    <path class="p-arrow-dashed" marker-end="url(#arrowhead)" d="M210,154 V180 H58 V140"></path>
    <text class="p-text" x="134" y="198" text-anchor="middle">the request returns at once</text>
  </svg>
</Plate>
