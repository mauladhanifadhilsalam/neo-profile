---
import Plate from './Plate.astro';
---
<Plate number="I" caption="The shape of the change, shewn schematically. The services are left unnamed in this edition.">
  <svg viewBox="0 0 680 240" role="img" aria-labelledby="plate-legacy-title">
    <title id="plate-legacy-title">Plate I: an Express.js application of routes, handlers and shared helpers is refactored into NestJS modules, which are then divided toward separate services.</title>
    <rect class="p-fill" x="16" y="58" width="180" height="124"></rect>
    <rect class="p-frame" x="16" y="58" width="180" height="124"></rect>
    <rect class="p-inner" x="21" y="63" width="170" height="114"></rect>
    <rect class="p-box" x="34" y="72" width="144" height="24"></rect>
    <text class="p-title" x="106" y="89" text-anchor="middle">Express.js</text>
    <text class="p-small" x="106" y="122" text-anchor="middle">routes</text>
    <text class="p-small" x="106" y="142" text-anchor="middle">handlers &amp; middleware</text>
    <text class="p-small" x="106" y="162" text-anchor="middle">shared helpers</text>
    <text class="p-text" x="106" y="204" text-anchor="middle">the first edition</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M202,120 H258"></path>
    <text class="p-text" x="230" y="110" text-anchor="middle">refactor</text>

    <rect class="p-fill" x="266" y="34" width="180" height="172"></rect>
    <rect class="p-frame" x="266" y="34" width="180" height="172"></rect>
    <rect class="p-inner" x="271" y="39" width="170" height="162"></rect>
    <text class="p-title" x="356" y="64" text-anchor="middle">NestJS</text>
    <rect class="p-box" x="284" y="78" width="144" height="34"></rect>
    <rect class="p-box" x="284" y="120" width="144" height="34"></rect>
    <rect class="p-box" x="284" y="162" width="144" height="34"></rect>
    <text class="p-small" x="356" y="99" text-anchor="middle">module · controller · provider</text>
    <text class="p-small" x="356" y="141" text-anchor="middle">module · controller · provider</text>
    <text class="p-small" x="356" y="183" text-anchor="middle">module · controller · provider</text>
    <text class="p-text" x="356" y="228" text-anchor="middle">the second edition</text>

    <path class="p-arrow" marker-end="url(#arrowhead)" d="M452,120 H508"></path>
    <text class="p-text" x="480" y="98" text-anchor="middle">toward</text>
    <text class="p-text" x="480" y="112" text-anchor="middle">services</text>

    <rect class="p-fill" x="516" y="40" width="148" height="46"></rect>
    <rect class="p-frame" x="516" y="40" width="148" height="46"></rect>
    <text class="p-title" x="590" y="68" text-anchor="middle">Service</text>
    <rect class="p-fill" x="516" y="97" width="148" height="46"></rect>
    <rect class="p-frame" x="516" y="97" width="148" height="46"></rect>
    <text class="p-title" x="590" y="125" text-anchor="middle">Service</text>
    <rect class="p-fill" x="516" y="154" width="148" height="46"></rect>
    <rect class="p-frame" x="516" y="154" width="148" height="46"></rect>
    <text class="p-title" x="590" y="182" text-anchor="middle">Service</text>
    <text class="p-text" x="590" y="228" text-anchor="middle">the edition in progress</text>
  </svg>
</Plate>
